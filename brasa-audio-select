#!/bin/sh
# Select the default FreeBSD output device from the desktop.
set -eu
fail() { echo "brasa: $*" >&2; exit 1; }
command -v zenity >/dev/null 2>&1 || fail "zenity e necessario."
sndstat=${BRASA_SNDSTAT:-/dev/sndstat}
[ -r "$sndstat" ] || { zenity --error --text="Estado do audio FreeBSD indisponivel."; exit 1; }
if ! grep -q '^pcm[0-9][0-9]*:' "$sndstat"; then
  zenity --error --text="Nenhum dispositivo de audio. Conecte uma interface e consulte dmesg por uaudio ou pcm."
  exit 1
fi
rows=$(awk '
  /^pcm[0-9]+:/ {
    unit=$1; sub(":", "", unit); sub(/^pcm/, "", unit)
    label=$0; sub(/^pcm[0-9]+: /, "", label)
    state=(/default/ ? "Saida padrao atual" : "Disponivel")
    print unit "\t" state "\t" label
  }
' "$sndstat")
if command -v wpctl >/dev/null 2>&1; then
  virtual_rows=$(wpctl status -n 2>/dev/null | awk '
    /Sinks:/ { section=1; next }
    /Sources:/ { section=0 }
    section && /brasa\.aggregate\.output/ && match($0, /[0-9]+[.]/) {
      id=substr($0, RSTART, RLENGTH); sub(/[.]$/, "", id)
      print "pw:" id "\tSaida virtual Brasa" "\tAgregado Brasa"
    }
  ')
  [ -z "$virtual_rows" ] || rows="$rows
$virtual_rows"
fi
choice=$(printf '%s\n' "$rows" | zenity --list --title="Audio Brasa" --text="Escolha a saida de audio. O sistema pode pedir sua senha de administrador." --column="PCM / PipeWire" --column="Estado" --column="Dispositivo" --print-column=1 --separator='' --height=420 --width=720) || exit 0
[ -n "$choice" ] || exit 0
case "$choice" in
  pw:*)
    node_id=${choice#pw:}
    case "$node_id" in *[!0-9]*|'') zenity --error --text="Dispositivo PipeWire invalido."; exit 1 ;; esac
    if wpctl set-default "$node_id"; then
      zenity --info --text="A saida agregada Brasa foi selecionada como padrao para esta sessao."
      exit 0
    fi
    zenity --error --text="Nao foi possivel selecionar a saida agregada Brasa."
    exit 1
    ;;
esac
unit=$choice
[ -n "$unit" ] || exit 0
case "$unit" in *[!0-9]*) zenity --error --text="Dispositivo invalido."; exit 1 ;; esac
if [ "$(sysctl -n hw.snd.default_unit 2>/dev/null || echo desconhecido)" = "$unit" ] && ! command -v wpctl >/dev/null 2>&1; then
  zenity --info --text="Esta saida ja e a padrao."
  exit 0
fi
if command -v wpctl >/dev/null 2>&1; then
  pipewire_status=$(wpctl status -n 2>/dev/null || true)
  if [ -n "$pipewire_status" ]; then
    node_id=$(printf '%s\n' "$pipewire_status" | awk -v target="pcm$unit.play" 'index($0, target) && match($0, /[0-9]+[.]/) { id=substr($0, RSTART, RLENGTH); sub(/[.]$/, "", id); print id; exit }')
    if [ -z "$node_id" ]; then
      zenity --error --text="O PipeWire esta ativo, mas nao encontrou a saida pcm$unit. Nenhuma configuracao foi alterada."
      exit 1
    fi
    if wpctl set-default "$node_id"; then
      zenity --info --text="Saida pcm$unit selecionada como padrao do PipeWire nesta sessao."
      exit 0
    fi
    zenity --error --text="Nao foi possivel selecionar pcm$unit no PipeWire. Nenhuma configuracao do kernel foi alterada."
    exit 1
  fi
fi
if [ "$(sysctl -n hw.snd.default_unit 2>/dev/null || echo desconhecido)" = "$unit" ]; then
  zenity --info --text="Esta saida ja e a padrao do kernel."
  exit 0
fi
kdesu_bin=$(command -v kdesu 2>/dev/null || true)
if [ -z "$kdesu_bin" ] && [ -x /usr/local/lib/libexec/kf6/kdesu ]; then
  kdesu_bin=/usr/local/lib/libexec/kf6/kdesu
fi
if [ -n "$kdesu_bin" ]; then
  if "$kdesu_bin" -c "/sbin/sysctl hw.snd.default_unit=$unit"; then
    zenity --info --text="Saida pcm$unit selecionada nesta sessao. Reinicie apps que ja estavam usando audio."
  fi
else
  zenity --error --text="Prompt administrativo indisponivel. Execute como root: sysctl hw.snd.default_unit=$unit"
fi
