#!/bin/sh
# Graphical EXE importer/launcher. Reuse the app name to reuse its prefix.
set -eu
command -v zenity >/dev/null 2>&1 || { echo "Instale zenity para usar esta ferramenta grafica." >&2; exit 127; }
command -v wine >/dev/null 2>&1 || { zenity --error --text="Wine nao esta instalado."; exit 127; }
mode=$(zenity --list --radiolist --title="Apps Windows do Brasa" --text="Escolha uma acao." --column="" --column="Acao" --print-column=2 --separator="" TRUE "Instalar um app" FALSE "Abrir app instalado" --height=220 --width=420) || exit 0
[ -n "$mode" ] || exit 0
exe=$(zenity --file-selection --title="Escolha um executavel Windows" --file-filter="Executaveis Windows | *.exe" --file-filter="Todos os arquivos | *") || exit 0
[ -n "$exe" ] || exit 0
base=$(basename "$exe"); suggested=${base%.*}
if [ "$mode" = "Instalar um app" ]; then
  prompt="De um nome ao app. Use o mesmo nome depois para abrir o mesmo prefixo Wine:"
else
  prompt="Digite exatamente o nome usado na instalacao:"
fi
app_id=$(zenity --entry --title="Nome do app" --text="$prompt" --entry-text="$suggested") || exit 0
[ -n "$app_id" ] || exit 0
exec /usr/local/bin/brasa-run-windows "$exe" --name "$app_id"



