#!/bin/sh
# Show FreeBSD sound device inventory and relevant kernel attach events.
set -eu
sndstat=${BRASA_SNDSTAT:-/dev/sndstat}
[ -r "$sndstat" ] || { echo "Audio status is unavailable: $sndstat cannot be read." >&2; exit 1; }
printf '%s\n' 'Brasa Audio - FreeBSD sound devices' ''
cat "$sndstat"
printf '\nCurrent default unit:\n'
sysctl hw.snd.default_unit 2>/dev/null || true
printf '\nUSB audio feedback rates reported by uaudio (Hz):\n'
feedback_rates=$(sysctl -a 2>/dev/null | awk '$1 ~ /^dev\.pcm\.[0-9]+\.feedback_rate:/ { print }')
if [ -n "$feedback_rates" ]; then printf '%s\n' "$feedback_rates"; else printf '%s\n' 'No uaudio feedback_rate values are exposed by this kernel/device.'; fi
printf '\nMixer controls:\n'
mixer 2>/dev/null || true
if command -v wpctl >/dev/null 2>&1; then
  printf '\nPipeWire graph and aggregate devices:\n'
  graph=$(wpctl status -n 2>/dev/null || true)
  printf '%s\n' "$graph"
  printf '\nClock and driver properties:\n'
  node_ids=$(printf '%s\n' "$graph" | awk '/pcm[0-9]+\.(play|rec)|brasa\.aggregate\.(output|input)/ && match($0, /[0-9]+[.]/) { id=substr($0, RSTART, RLENGTH); sub(/[.]$/, "", id); print id }')
  master_rule=${XDG_CONFIG_HOME:-"$HOME/.config"}/wireplumber/wireplumber.conf.d/90-brasa-clock-master.conf
  master_match=''
  master_name=''
  master_description=''
  master_class=''
  master_seen=0
  master_active=0
  if [ -r "$master_rule" ]; then
    master_match=$(awk '/priority.driver = 1000000/ { line=$0; sub(/^.*matches = \[ \{ /, "", line); sub(/ \}.*$/, "", line); print line; exit }' "$master_rule")
    master_name=$(printf '%s\n' "$master_match" | sed -n 's/.*node.name = "\([^"]*\)".*/\1/p')
    master_description=$(printf '%s\n' "$master_match" | sed -n 's/.*node.description = "\([^"]*\)".*/\1/p')
    master_class=$(printf '%s\n' "$master_match" | sed -n 's/.*media.class = "\([^"]*\)".*/\1/p')
  fi
  for node_id in $node_ids; do
    props=$(wpctl inspect "$node_id" 2>/dev/null || true)
    printf '%s\n' "$props" | grep -E 'node\.(name|description)|priority\.driver|clock\.name|oss\.(delay|fragment)' | while IFS= read -r prop; do
      case "$prop" in
        *oss.fragment*) printf '  %s (valor efetivo reportado pelo OSS-ng)\n' "$prop" ;;
        *) printf '%s\n' "$prop" ;;
      esac
    done
    if [ -n "$master_match" ] && [ -n "$master_class" ]; then
      matches=0
      if [ -n "$master_name" ] && printf '%s\n' "$props" | grep -Fq "node.name = \"$master_name\""; then matches=1; fi
      if [ -n "$master_description" ] && printf '%s\n' "$props" | grep -Fq "node.description = \"$master_description\""; then matches=1; fi
      if [ "$matches" -eq 1 ] && printf '%s\n' "$props" | grep -Fq "media.class = \"$master_class\""; then
        master_seen=1
        if printf '%s\n' "$props" | grep -Fq 'priority.driver = 1000000'; then master_active=1; fi
      fi
    fi
  done
  if [ -n "$master_match" ]; then
    if [ "$master_active" -eq 1 ]; then
      printf '\nConfigured clock master is connected and has the configured high driver priority; this does not prove it is driving the active graph. Use the stability monitor during playback or capture to check that.\n'
    elif [ "$master_seen" -eq 1 ]; then
      printf '\nConfigured clock master is connected, but the configured priority is not present on its node; restart the audio session to reload the rule.\n'
    else
      printf '\nConfigured clock master is not present in the current PipeWire graph; its rule will apply when the device returns.\n'
    fi
  fi
fi
if command -v pw-link >/dev/null 2>&1; then
  printf '\nPipeWire audio links (physical member connection evidence):\n'
  links=$(pw-link -l 2>/dev/null || true)
  if [ -n "$links" ]; then
    aggregate_links=$(printf '%s\n' "$links" | grep -E 'brasa\.aggregate\.(output|input)' || true)
    if [ -n "$aggregate_links" ]; then printf '%s\n' "$aggregate_links"; else printf '%s\n' 'No links to Brasa aggregate nodes were reported.'; fi
  else
    printf '%s\n' 'No PipeWire port links were reported.'
  fi
  if latency=$(pw-link -t 2>/dev/null); then
    aggregate_latency=$(printf '%s\n' "$latency" | grep -E 'brasa\.aggregate\.(output|input)' || true)
    if [ -n "$aggregate_latency" ]; then
      printf '\nReported latency for Brasa aggregate ports:\n%s\n' "$aggregate_latency"
    fi
  fi
  printf '%s\n' 'Links confirm graph connectivity only; they do not measure resampler drift or physical clock phase.'
fi
if command -v pw-top >/dev/null 2>&1; then
  printf '\nPipeWire runtime statistics (including xruns/errors):\n'
  stats=$(pw-top --batch-mode --iterations=1 2>&1) || {
    printf '%s\n' "$stats"
    echo 'Could not read PipeWire runtime statistics.'
    stats=''
  }
  if [ -n "$stats" ]; then
    printf '%s\n' "$stats"
    drivers=$(printf '%s\n' "$stats" | awk '$NF ~ /^pcm[0-9]+\.(play|rec)$/ && $(NF-1) !~ /^[+*=]$/ {print}')
    if [ -n "$drivers" ]; then
      printf '\nPhysical PCM driver row(s) reported by pw-top:\n%s\n' "$drivers"
    else
      printf '\nNo physical PCM driver row could be identified in this pw-top snapshot.\n'
    fi
  fi
else
  printf '\nPipeWire runtime statistics are unavailable (pw-top is not installed).\n'
fi
printf '\nUSB audio attach/detach messages:\n'
dmesg | grep -Ei 'uaudio|pcm' || true
