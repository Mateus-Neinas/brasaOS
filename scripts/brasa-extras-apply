#!/bin/sh
# Install optional desktop/audio applications after the stable base installation.
set -eu

fail() {
  printf '\nERRO: %s\n' "$*" >&2
  printf 'Log salvo em /var/log/brasa-extras.log\n' >&2
  exit 1
}
say() { printf '\nBrasa Extras: %s\n' "$*"; }

[ "$(id -u)" -eq 0 ] || fail 'Este assistente precisa de privilégios de administrador.'
[ "$(uname -s)" = FreeBSD ] || fail 'Este assistente requer FreeBSD.'
[ "$(uname -m)" = amd64 ] || fail 'Este pacote de extras requer amd64.'
[ "$#" -eq 2 ] && [ "$1" = --user ] || fail 'Uso interno inválido.'
user=$2
case "$user" in ''|*[!a-zA-Z0-9_-]*) fail 'Conta Brasa inválida.' ;; esac

userinfo=$(pw usershow "$user" 2>/dev/null) || fail "A conta $user não foi encontrada."
uid=$(printf '%s\n' "$userinfo" | awk -F: '{print $3}')
home=$(printf '%s\n' "$userinfo" | awk -F: '{print $9}')
group=$(id -gn "$user")
[ -n "$uid" ] && [ -n "$home" ] && [ -d "$home" ] || fail 'Não consegui localizar a pasta pessoal da conta.'

install -d -m 0755 /var/log
log=/var/log/brasa-extras.log
touch "$log"
chmod 0644 "$log"
say() {
  printf '\nBrasa Extras: %s\n' "$*" | tee -a "$log"
}
run_logged() {
  "$@" >>"$log" 2>&1 &
  command_pid=$!
  tail -n 0 -f "$log" &
  tail_pid=$!
  if wait "$command_pid"; then status=0; else status=$?; fi
  kill "$tail_pid" 2>/dev/null || true
  wait "$tail_pid" 2>/dev/null || true
  return "$status"
}

say 'Atualizando a lista de aplicativos.'
run_logged pkg update -f || fail 'Não foi possível atualizar a lista de pacotes. Verifique a conexão com a internet.'

say 'Instalando Firefox e as janelas gráficas de áudio.'
run_logged pkg install -y firefox zenity sox || fail 'Não foi possível instalar Firefox e as ferramentas gráficas de áudio.'

say 'Instalando PipeWire e o suporte aos dispositivos de áudio do FreeBSD.'
if pkg rquery '%n' pipewire-spa-oss-ng 2>/dev/null | grep -qx pipewire-spa-oss-ng; then
  audio_backend=pipewire-spa-oss-ng
elif pkg rquery '%n' pipewire-spa-oss 2>/dev/null | grep -qx pipewire-spa-oss; then
  audio_backend=pipewire-spa-oss
else
  fail 'O repositório não oferece o backend OSS do PipeWire; áudio USB class compliant do kernel continua disponível.'
fi
run_logged pkg install -y pipewire wireplumber "$audio_backend" || fail 'Não foi possível instalar o serviço de áudio Brasa.'

say 'Instalando Wine e os componentes de compatibilidade disponíveis.'
if pkg rquery '%n' wine 2>/dev/null | grep -qx wine; then
  wine_packages='wine'
  for package in wine-gecko wine-mono; do
    if pkg rquery '%n' "$package" 2>/dev/null | grep -qx "$package"; then
      wine_packages="$wine_packages $package"
    fi
  done
  # Package names come only from this fixed allowlist.
  # shellcheck disable=SC2086
  run_logged pkg install -y $wine_packages || printf 'Aviso: Wine não foi instalado; consulte /var/log/brasa-extras.log.\n'
else
  printf 'Aviso: Wine não está disponível neste repositório.\n'
fi

# The RX 6600 uses Dimgrey Cavefish firmware. Install its firmware only when
# that adapter is present; leave KMS disabled so the known-safe UEFI desktop
# remains the boot path until the user explicitly opts into acceleration.
if pciconf -l 2>/dev/null | grep -qi 'vendor=0x1002 device=0x73ff'; then
  say 'Instalando o firmware da Radeon RX 6600; a aceleração permanece desativada por segurança.'
  run_logged pkg install -y gpu-firmware-amd-kmod-dimgrey-cavefish || {
    printf 'Aviso: não consegui instalar o firmware AMD específico; consulte /var/log/brasa-extras.log.\n'
  }
fi

say 'Ativando o serviço de áudio Brasa na sessão KDE.'
autostart_dir=$home/.config/autostart
install -d -o "$user" -g "$group" -m 0755 "$autostart_dir"
if [ ! -e "$autostart_dir/brasa-pipewire.desktop" ]; then
  cat > "$autostart_dir/brasa-pipewire.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Brasa Audio Engine
Exec=/usr/local/bin/brasa-audio-start
OnlyShowIn=KDE;
X-KDE-autostart-after=panel
EOF
  chown "$user:$group" "$autostart_dir/brasa-pipewire.desktop"
  chmod 0644 "$autostart_dir/brasa-pipewire.desktop"
fi

touch /var/db/brasa-extras-ready
say 'Concluído. Firefox e as ferramentas de áudio estão instalados.'
printf 'A instalação principal permaneceu separada. Para conferir o resultado: /var/log/brasa-extras.log\n'
