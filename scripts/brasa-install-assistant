#!/bin/sh
# Graphical Brasa installer front end for the future FreeBSD live image.
# Destructive disk operations are delegated to bsdinstall after confirmation.
set -eu

title='Instalar Brasa'
minimum_bytes=42949672960

fail() {
  zenity --error --title="$title" --width=560 --text="$1"
  exit 1
}

cancelled() {
  zenity --info --title="$title" --width=520 --text='Instalação cancelada. Nenhum disco foi alterado.'
  exit 0
}

command -v zenity >/dev/null 2>&1 || {
  printf '%s\n' 'O instalador gráfico precisa do Zenity no ambiente live Brasa.' >&2
  exit 1
}
[ "$(id -u)" -eq 0 ] || fail 'Abra o instalador pelo ícone Instalar Brasa no ambiente live.'
[ "$(uname -s)" = FreeBSD ] && [ "$(uname -m)" = amd64 ] || \
  fail 'Esta mídia de instalação funciona em computadores x86 de 64 bits.'
[ -f /var/run/brasa-live-environment ] || \
  fail 'O ambiente live Brasa ainda não está integrado nesta ISO. Nenhum disco foi alterado.'
command -v bsdinstall >/dev/null 2>&1 || fail 'O instalador FreeBSD não foi encontrado nesta mídia.'
command -v geom >/dev/null 2>&1 || fail 'Não foi possível consultar os discos deste computador.'
brasa_payload=${BRASA_PAYLOAD:-/brasa/BRASA_PROJECT_TAR_GZ}
[ -r "$brasa_payload" ] || fail 'Não encontrei os arquivos Brasa na mídia. Reinicie pelo pendrive de instalação correto.'

zenity --question --title="$title" --width=560 \
  --text='Bem-vindo ao Brasa. O assistente prepara o computador para você. Se continuar, o conteúdo do disco escolhido será apagado. Você poderá cancelar antes da confirmação final.' \
  --ok-label='Continuar' --cancel-label='Sair' || exit 0

full_name=$(zenity --entry --title="$title" --width=560 --text='Como você quer ser chamado?') || exit 0
[ -n "$full_name" ] || fail 'Informe seu nome para continuar.'
case "$full_name" in *'|'*) fail 'Remova o caractere | do nome e tente novamente.' ;; esac

username=$(zenity --entry --title="$title" --width=560 \
  --text='Escolha o nome curto para entrar. Use letras minúsculas, números, _ ou -.' \
  --entry-text='') || exit 0
case "$username" in ''|*[!a-z0-9_-]*) fail 'O nome de usuário deve usar letras minúsculas, números, _ ou -.' ;; esac
case "$username" in [a-z]*) ;; *) fail 'O nome de usuário deve começar com uma letra minúscula.' ;; esac
[ "${#username}" -le 32 ] || fail 'O nome de usuário pode ter até 32 caracteres.'
case "$username" in root|toor|operator|daemon|nobody) fail 'Escolha outro nome de usuário.' ;; esac

password=$(zenity --entry --hide-text --title="$title" --width=560 \
  --text='Escolha uma senha. A mesma senha será usada para entrar e para administrar o Brasa.') || exit 0
[ -n "$password" ] || { unset password; fail 'A senha não pode ficar vazia.'; }
password_again=$(zenity --entry --hide-text --title="$title" --width=560 --text='Digite a senha novamente.') || {
  unset password
  exit 0
}
[ "$password" = "$password_again" ] || {
  unset password password_again
  fail 'As senhas não coincidem. Reabra o assistente para tentar novamente.'
}
unset password_again

# Resolve mounted providers, including ISO and UFS labels, to their physical
# disks. If a device-backed mount cannot be resolved, refuse to offer a disk.
protected_disks() {
  mount -p 2>/dev/null | awk '{print $1}' | while IFS= read -r source; do
    case "$source" in /dev/*) ;; *) continue ;; esac
    provider=$(realpath "$source" 2>/dev/null || printf '%s\n' "$source")
    case "$provider" in
      /dev/iso9660/*|/dev/ufs/*|/dev/label/*|/dev/gpt/*|/dev/ufsid/*)
        label=${provider#/dev/}
        provider=$(glabel status 2>/dev/null | awk -v label="$label" '$1 == label { print $3; exit }')
        [ -n "$provider" ] || { printf 'UNRESOLVED\n'; continue; }
        ;;
    esac
    provider=${provider#/dev/}
    provider=$(printf '%s\n' "$provider" | sed -E 's/p[0-9]+$//; s/s[0-9]+[a-z]?$//')
    case "$provider" in
      ada[0-9]*|da[0-9]*|nda[0-9]*|nvd[0-9]*|vtbd[0-9]*|mmcsd[0-9]*|cd[0-9]*|md[0-9]*) printf '%s\n' "$provider" ;;
      *) printf 'UNRESOLVED\n' ;;
    esac
  done
}
boot_disks=$(protected_disks)
if printf '%s\n' "$boot_disks" | grep -qx UNRESOLVED; then
  unset password
  fail 'Não foi possível identificar com segurança a mídia de inicialização. Nenhum disco foi alterado.'
fi

disk_rows=$(geom disk list 2>/dev/null | awk -v minimum="$minimum_bytes" -v boot="$boot_disks" '
  function emit(   n, boot_list, count) {
    if (name == "" || bytes < minimum) return
    if (model == "") model = "Modelo não informado"
    if (name !~ /^(ada|da|nda|nvd|vtbd|mmcsd)[0-9]+$/) return
    count = split(boot, boot_list, /[[:space:]]+/)
    for (n = 1; n <= count; n++) if (boot_list[n] == name) return
    gsub(/[\t\r\n]/, " ", model)
    gsub(/[\t\r\n]/, " ", ident)
    if (ident == "") ident = "Não informado"
    if (size == "") size = sprintf("%.0f GiB", bytes / 1073741824)
    printf "%s\t%s\t%s\t%s\t%.0f\n", name, model, size, ident, bytes
  }
  /^Geom name:/ {
    emit()
    name = $3; model = ""; ident = ""; bytes = 0; size = ""
    next
  }
  /^[[:space:]]*descr:/ { sub(/^[[:space:]]*descr:[[:space:]]*/, ""); model = $0; next }
  /^[[:space:]]*ident:/ { sub(/^[[:space:]]*ident:[[:space:]]*/, ""); ident = $0; next }
  /^[[:space:]]*Mediasize:/ {
    copy = $0
    if (match(copy, /[0-9]+/)) bytes = substr(copy, RSTART, RLENGTH) + 0
    if (match(copy, /\([^)]*\)/)) { size = substr(copy, RSTART + 1, RLENGTH - 2); gsub(/ /, "", size) }
  }
  END { emit() }
')
[ -n "$disk_rows" ] || { unset password; fail 'Não encontrei um disco de pelo menos 40 GB. Conecte um disco adequado e tente novamente.'; }

tab=$(printf '\t')
set --
first_row=TRUE
while IFS="$tab" read -r candidate_disk candidate_model candidate_size candidate_ident candidate_bytes; do
  [ -n "$candidate_disk" ] || continue
  set -- "$@" "$first_row" "$candidate_disk" "$candidate_model" "$candidate_size" "$candidate_ident" "$candidate_bytes"
  first_row=FALSE
done <<EOF
$disk_rows
EOF
selected_result=$(zenity --list --title="$title" --width=760 --height=420 \
  --text='Selecione o disco onde o Brasa será instalado. O conteúdo desse disco será apagado.' \
  --radiolist --column='Selecionar' --column='Disco' --column='Modelo' --column='Capacidade' --column='Identificação' --column='Bytes' \
  --print-column=ALL --separator='|' --hide-column=6 "$@") || { unset password; cancelled; }
selected_disk=$(printf '%s\n' "$disk_rows" | awk -F '\t' -v selection="$selected_result" '
  BEGIN { fields_count = split(selection, fields, "|"); for (i = 1; i <= fields_count; i++) selected[fields[i]] = 1 }
  $1 in selected { print $1; found = 1; exit }
  END { if (!found) exit 1 }
') || { unset password; fail 'A seleção do disco não foi reconhecida. Nenhum disco foi alterado.'; }
case "$selected_disk" in ''|*[!a-zA-Z0-9_]*) unset password; fail 'A seleção do disco não é válida.' ;; esac

selected_row=$(printf '%s\n' "$disk_rows" | awk -F '\t' -v target="$selected_disk" '$1 == target { print; exit }')
[ -n "$selected_row" ] || { unset password; fail 'O disco escolhido não está mais disponível.'; }
selected_model=$(printf '%s\n' "$selected_row" | awk -F '\t' '{print $2}')
selected_size=$(printf '%s\n' "$selected_row" | awk -F '\t' '{print $3}')
selected_ident=$(printf '%s\n' "$selected_row" | awk -F '\t' '{print $4}')
selected_bytes=$(printf '%s\n' "$selected_row" | awk -F '\t' '{print $5}')

confirmation=$(printf 'O disco abaixo será apagado por completo. Seus arquivos e sistemas atuais serão removidos.\n\nDisco: %s\nModelo: %s\nCapacidade: %s\nIdentificação: %s\n\nO Brasa criará automaticamente as partições de inicialização e do sistema. A mesma senha será usada para sua conta e para administração. Continue somente se este for o disco correto.' "$selected_disk" "$selected_model" "$selected_size" "$selected_ident")
zenity --question --title='Confirme o apagamento do disco' --width=600 \
  --default-cancel --ok-label='Apagar e instalar' --cancel-label='Voltar' \
  --no-markup --text="$confirmation" || { unset password; cancelled; }

validate_selected_disk() {
current_protected=$(protected_disks)
if printf '%s\n' "$current_protected" | grep -qx UNRESOLVED || printf '%s\n' "$current_protected" | grep -Fxq "$selected_disk"; then
  unset password
  fail 'O disco selecionado está em uso ou a mídia de inicialização não pôde ser identificada. Nenhuma instalação foi iniciada.'
fi
current_details=$(geom disk list "$selected_disk" 2>/dev/null | awk -v target="$selected_disk" '
  /^Geom name:/ { if ($3 != target) exit 1 }
  /^[[:space:]]*Mediasize:/ { if (match($0, /[0-9]+/)) bytes = substr($0, RSTART, RLENGTH) + 0 }
  /^[[:space:]]*descr:/ { sub(/^[[:space:]]*descr:[[:space:]]*/, ""); model = $0 }
  /^[[:space:]]*ident:/ { sub(/^[[:space:]]*ident:[[:space:]]*/, ""); ident = $0 }
  END { if (model == "") model = "Modelo não informado"; if (ident == "") ident = "Não informado"; printf "%.0f\t%s\t%s\n", bytes, model, ident }
') || { unset password; fail 'Não foi possível confirmar o disco. Nenhuma instalação foi iniciada.'; }
current_bytes=$(printf '%s\n' "$current_details" | awk -F '\t' '{print $1}')
current_model=$(printf '%s\n' "$current_details" | awk -F '\t' '{print $2}')
current_ident=$(printf '%s\n' "$current_details" | awk -F '\t' '{print $3}')
case "$current_bytes" in ''|*[!0-9]*) unset password; fail 'Não foi possível confirmar o tamanho do disco.' ;; esac
[ "$current_bytes" = "$selected_bytes" ] && [ "$current_model" = "$selected_model" ] && [ "$current_ident" = "$selected_ident" ] || \
  { unset password; fail 'O disco mudou desde a seleção. Nenhuma instalação foi iniciada.'; }
}

# Best-effort DHCP for optional hardware packages after the base install. The
# FreeBSD base and generic kernel are shipped on the ISO, so no network is
# required to install or boot the selected machine.
if ! route -n get default >/dev/null 2>&1; then
  printf 'timeout 20;\nretry 10;\n' > /tmp/brasa-dhclient.conf
  for interface in $(ifconfig -l); do
    case "$interface" in lo*|wlan*|bridge*|lagg*|vlan*|tun*|tap*|pflog*|pfsync*) continue ;; esac
    ifconfig "$interface" up 2>/dev/null || continue
    ifconfig "$interface" | grep -q 'inet ' && continue
    dhclient -c /tmp/brasa-dhclient.conf "$interface" >/dev/null 2>&1 || true
    route -n get default >/dev/null 2>&1 && break
  done
fi
validate_selected_disk

password_file=$(mktemp /tmp/brasa-password.XXXXXX)
name_file=$(mktemp /tmp/brasa-name.XXXXXX)
install_script=$(mktemp /tmp/brasa-install.XXXXXX)
install_log=$(mktemp /tmp/brasa-install-log.XXXXXX)
progress_dir=$(mktemp -d /tmp/brasa-progress.XXXXXX)
progress_pipe=$progress_dir/progress
dist_dir=$(mktemp -d /tmp/brasa-distributions.XXXXXX)
bsdinstall_log=$dist_dir/bsdinstall.log
install_phase_file=/tmp/brasa-install-phase
rm -f "$install_phase_file"
freebsd_dist_dir=/brasa/freebsd-dist
for distribution in base.txz kernel.txz MANIFEST; do
  [ -r "$freebsd_dist_dir/$distribution" ] || {
    unset password
    fail "A mídia está sem o conjunto local $distribution. Nenhum disco foi alterado."
  }
done
brasa_repo_db=/dev/null
brasa_repo_meta=/dev/null
brasa_repo_catalog_available=no
if [ -r /brasa/BRASA_PKG_REPOSITORY_DB ] && [ -r /brasa/BRASA_PKG_REPOSITORY_META ]; then
  brasa_repo_db=/brasa/BRASA_PKG_REPOSITORY_DB
  brasa_repo_meta=/brasa/BRASA_PKG_REPOSITORY_META
  brasa_repo_catalog_available=yes
fi
mkfifo "$progress_pipe"
chmod 600 "$password_file" "$name_file" "$install_script" "$install_log"
cleanup() {
  unset password
  rm -f "$password_file" "$name_file" "$install_script" "$progress_pipe"
  rm -f "$install_phase_file"
  rmdir "$progress_dir" 2>/dev/null || true
  rm -f "$bsdinstall_log"
  rmdir "$dist_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM
printf '%s\n' "$password" > "$password_file"
printf '%s\n' "$full_name" > "$name_file"
unset password

cat > "$install_script" <<EOF
PARTITIONS="$selected_disk"
DISTRIBUTIONS="base.txz kernel.txz"
export DISTRIBUTIONS
BRASA_REPO_CATALOG_AVAILABLE="$brasa_repo_catalog_available"
export BRASA_REPO_CATALOG_AVAILABLE

#!/bin/sh
set -eu
username="$username"
EOF
cat >> "$install_script" <<'EOF'
IFS= read -r full_name <&6
printf '\nBrasa: Copiando o catálogo do repositório para o sistema instalado.\n'
if [ "$BRASA_REPO_CATALOG_AVAILABLE" = yes ]; then
  mkdir -p /var/db/pkg/repos/FreeBSD-ports
  cat <&10 > /var/db/pkg/repos/FreeBSD-ports/db
  cat <&11 > /var/db/pkg/repos/FreeBSD-ports/meta
  : > /var/db/brasa-live-repo-catalog-ready
fi
mkdir -p /tmp/brasa-source
printf '\nBrasa: Extraindo os arquivos de configuração do Brasa.\n'
tar -xzf - -C /tmp/brasa-source <&7
printf '\nBrasa: Criando a conta de usuário.\n'
pw useradd -n "$username" -m -d "/home/$username" -s /bin/sh -G wheel,video,operator -c "$full_name"
printf '\nBrasa: Definindo as senhas da conta e de administrador.\n'
pw usermod root -h 8
pw usermod "$username" -h 9
printf '%s|%s\n' "$username" "$full_name" > /var/db/brasa-live-user
: > /var/db/brasa-password-ready
printf '\nBrasa: Configurando a rede do sistema instalado.\n'
sysrc ifconfig_DEFAULT="DHCP"
cd /tmp/brasa-source
printf '\nBrasa: Iniciando o bootstrap do desktop e dos componentes.\n'
sh scripts/bootstrap-freebsd.sh --installing-from-live
printf '\nBrasa: Bootstrap concluído.\n'
cd /
rm -rf /tmp/brasa-source
EOF

zenity --progress --no-cancel --auto-close --title="$title" --width=680 \
  --text='Preparando a instalação. Não desligue o computador.' \
  < "$progress_pipe" &
progress_pid=$!
exec 3> "$progress_pipe"
report_progress() {
  percentage=$1
  shift
  printf '# %s\n%s\n' "$*" "$percentage" >&3
}
process_is_running() {
  process_state=$(ps -o stat= -p "$1" 2>/dev/null || true)
  case "$process_state" in ''|Z*) return 1 ;; *) return 0 ;; esac
}
(
  set -e
  export BSDINSTALL_DISTDIR="$freebsd_dist_dir"
  export BSDINSTALL_LOG="$bsdinstall_log"
  report_progress 2 'Preparando os componentes oficiais do FreeBSD...'
  printf '%s\n' 'Brasa: Instalando a base e o kernel locais do FreeBSD 15.1.' >> "$install_log"
  report_progress 5 'Usando a base e o kernel incluídos na ISO...'
  validate_selected_disk
  report_progress 8 'Preparando as partições e iniciando a instalação do FreeBSD...'
  # Extract the checked, local FreeBSD base and generic kernel archives from
  # the ISO. bsdinstall's fetchmissingdists sees both sets locally and does not
  # prompt for a mirror or download the operating system over the network.
  bsdinstall script "$install_script" 6< "$name_file" 7< "$brasa_payload" \
    8< "$password_file" 9< "$password_file" 10< "$brasa_repo_db" 11< "$brasa_repo_meta" \
    < /dev/null >> "$install_log" 2>&1 &
  bsdinstall_pid=$!
  last_percentage=8
  last_reported_percentage=-1
  last_reported_message=''
  last_serial_message=''
  elapsed_seconds=0
  base_install_done=no
  while process_is_running "$bsdinstall_pid"; do
    bsd_line=$(tail -n 1 "$bsdinstall_log" 2>/dev/null || true)
    output_line=$(tail -n 1 "$install_log" 2>/dev/null || true)
    install_phase=$(cat "$install_phase_file" 2>/dev/null || true)
    progress_source="$bsd_line $output_line"
    progress_message=${output_line:-$bsd_line}
    # bsdinstall writes its verbose BSDCONFIG trace to BSDINSTALL_LOG while
    # installing the base. Those DEBUG records are implementation details,
    # not useful progress text. Prefer the package/bootstrap output, then a
    # plain-language fallback if neither log has a user-facing line.
    case "$progress_message" in
      DEBUG:*) progress_message=$output_line ;;
    esac
    case "$progress_message" in *'FreeBSD Installer'*) progress_message='' ;; esac
    case "$progress_source" in
      *bootconfig*|*rootpass*|*'bsdinstall config'*)
        base_install_done=yes
        [ "$last_percentage" -lt 82 ] && last_percentage=82
        ;;
      *pkgbase*|*FreeBSD-base*|*FreeBSD-set*|*Extracting*|*Fetching*)
        if [ "$base_install_done" = no ] && [ "$last_percentage" -lt 7 ]; then last_percentage=7; fi
        ;;
    esac
    # pkg prefixes both Installing and Extracting lines with [current/total].
    # Count either form so a large archive extraction visibly advances too.
    package_counts=$(printf '%s\n' "$output_line" | sed -nE 's/.*\[([0-9]+)\/([0-9]+)\].*/\1 \2/p' | tail -n 1)
    if [ -n "$package_counts" ]; then
      installed=$(printf '%s\n' "$package_counts" | awk '{print $1}')
      package_total=$(printf '%s\n' "$package_counts" | awk '{print $2}')
      if [ "$package_total" -gt 0 ]; then
        if [ "$base_install_done" = yes ]; then
          package_percentage=$((90 + installed * 9 / package_total))
        else
          package_percentage=$((8 + installed * 72 / package_total))
        fi
        [ "$package_percentage" -le 99 ] || package_percentage=99
        [ "$package_percentage" -gt "$last_percentage" ] && last_percentage=$package_percentage
      fi
    elif [ "$last_percentage" -lt 90 ] && [ -n "$output_line" ]; then
      case "$output_line" in
        *'bsdinstall config'*) last_percentage=82 ;;
        *'pkgbase'*|*'FreeBSD-base'*) [ "$last_percentage" -lt 12 ] && last_percentage=12 ;;
      esac
    fi
    case "$install_phase" in
      particionando)
        progress_message='Preparando as partições do disco escolhido...'
        [ "$last_percentage" -lt 9 ] && last_percentage=9
        ;;
      verificando-distribuicoes)
        progress_message='Conferindo a base e o kernel incluídos na ISO...'
        [ "$last_percentage" -lt 12 ] && last_percentage=12
        ;;
      extraindo-base)
        progress_message='Instalando os arquivos-base do FreeBSD pelo disco local...'
        [ "$last_percentage" -lt 18 ] && last_percentage=18
        ;;
      extraindo-kernel)
        progress_message='Instalando o kernel e os drivers incluídos na ISO...'
        [ "$last_percentage" -lt 68 ] && last_percentage=68
        ;;
      configurando-boot)
        progress_message='Configurando a inicialização do Brasa...'
        [ "$last_percentage" -lt 82 ] && last_percentage=82
        ;;
      configurando-sistema)
        progress_message='Configurando contas e serviços do sistema...'
        [ "$last_percentage" -lt 88 ] && last_percentage=88
        ;;
      bsdinstall-config-start)
        progress_message='Finalizando a configuração do FreeBSD...'
        ;;
      bsdinstall-config-returned)
        progress_message='Configuração do FreeBSD concluída; preparando o Brasa...'
        ;;
      bsdinstall-config-rcconf)
        progress_message='Configurando a rede e os serviços do sistema...'
        ;;
      bsdinstall-config-etc)
        progress_message='Copiando os arquivos de configuração do sistema...'
        ;;
      bsdinstall-config-boot)
        progress_message='Configurando os arquivos de inicialização...'
        ;;
      bsdinstall-config-newaliases)
        progress_message='Configurando os aliases do sistema...'
        ;;
      bsdinstall-config-newaliases-done)
        progress_message='Finalizando os aliases do sistema...'
        ;;
      bsdinstall-config-complete)
        progress_message='Configuração da base FreeBSD concluída...'
        ;;
      bsdinstall-postinstall-copy)
        progress_message='Preparando o script de instalação no sistema-alvo...'
        ;;
      bsdinstall-postinstall-chmod)
        progress_message='Ajustando as permissões do script de instalação...'
        ;;
      bsdinstall-postinstall-start)
        progress_message='Iniciando a configuração do Brasa no sistema instalado...'
        ;;
      bsdinstall-postinstall-returned)
        progress_message='Configuração do Brasa concluída; finalizando a instalação...'
        ;;
      bsdinstall-postinstall-cleanup)
        progress_message='Limpando os arquivos temporários da instalação...'
        ;;
      configurando-brasa)
        case "$output_line" in
          ''|DEBUG:*) progress_message='Preparando KDE, áudio USB e suporte do computador...' ;;
          *'FreeBSD Installer'*) progress_message='Preparando KDE, áudio USB e suporte do computador...' ;;
          *) progress_message=$output_line ;;
        esac
        [ "$last_percentage" -lt 92 ] && last_percentage=92
        ;;
    esac
    progress_message=$(printf '%s' "$progress_message" | tr '\t\r\n' '   ' | \
      sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' | cut -c 1-180)
    if [ -z "$progress_message" ] || [ "${progress_message#DEBUG:}" != "$progress_message" ]; then
      case "$progress_source" in
        *pkgbase*|*FreeBSD-base*) progress_message='Preparando a instalação dos pacotes do sistema base FreeBSD...' ;;
        *distextract*|*extract*) progress_message='Instalando os arquivos do FreeBSD no disco...' ;;
        *bootconfig*) progress_message='Preparando a inicialização do sistema instalado...' ;;
        *rootpass*) progress_message='Configurando a conta de administração...' ;;
        *'bsdinstall config'*) progress_message='Configurando o sistema instalado...' ;;
        *) progress_message='Instalando o sistema base do FreeBSD no disco escolhido...' ;;
      esac
    fi
    if [ "$progress_message" != "$last_serial_message" ]; then
      printf 'Brasa: %s\n' "$progress_message" > /dev/ttyu0 2>/dev/null || true
      last_serial_message=$progress_message
    fi
    elapsed_seconds=$((elapsed_seconds + 2))
    if [ "$last_percentage" -eq "$last_reported_percentage" ] && [ "$progress_message" = "$last_reported_message" ]; then
      progress_message="$progress_message (${elapsed_seconds}s nesta etapa)"
    else
      last_reported_percentage=$last_percentage
      last_reported_message=$progress_message
      elapsed_seconds=0
    fi
    report_progress "$last_percentage" "$progress_message"
    sleep 2
  done
  if wait "$bsdinstall_pid"; then
    printf '%s\n' 'Instalação da base e configuração do desktop concluídas.' >> "$install_log"
    report_progress 100 'Instalação concluída. Preparando a mensagem final...'
  else
    bsdinstall_status=$?
    cat "$bsdinstall_log" >> "$install_log" 2>/dev/null || true
    exit "$bsdinstall_status"
  fi
) > "$install_log" 2>&1 &
installer_pid=$!
if wait "$installer_pid"; then install_status=0; else install_status=$?; fi
exec 3>&-
wait "$progress_pid" || true
rm -f "$progress_pipe"
if [ "$install_status" -ne 0 ]; then
  zenity --error --title="$title" --width=560 \
    --text='A instalação não terminou. O disco escolhido pode ter sido alterado. Consulte os detalhes e reinicie antes de tentar novamente.'
  zenity --text-info --title='Detalhes da instalação' --width=760 --height=460 --filename="$install_log" || true
  if zenity --question --title="$title" --width=600 --default-cancel \
    --ok-label='Tentar novamente' --cancel-label='Sair para o instalador FreeBSD' \
    --text='A instalação não foi concluída. O disco pode ter sido parcialmente alterado. Se tentar novamente, selecione e confirme o disco mais uma vez.'; then
    cleanup
    trap - EXIT HUP INT TERM
    exec /bin/sh "$0"
  fi
  exit 1
fi

zenity --info --title='Brasa instalado' --width=560 \
  --text="A instalação terminou.\n\nConta: $username\nSenha: a que você escolheu\n\nReinicie e remova a mídia de instalação."
