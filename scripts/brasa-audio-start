#!/bin/sh
# Start PipeWire and WirePlumber in the logged-in FreeBSD desktop session.
set -eu
fail() {
  if command -v zenity >/dev/null 2>&1; then zenity --error --title="Áudio Brasa" --text="$*"; else echo "brasa: $*" >&2; fi
  exit 1
}
[ -n "${XDG_RUNTIME_DIR:-}" ] || fail "o login nao definiu XDG_RUNTIME_DIR. Verifique pam_xdg(8) antes de iniciar PipeWire."
[ -d "$XDG_RUNTIME_DIR" ] || fail "diretorio de sessao indisponivel: $XDG_RUNTIME_DIR"
uid=$(id -u)
owner=$(stat -f '%u' "$XDG_RUNTIME_DIR" 2>/dev/null || echo unknown)
[ "$owner" = "$uid" ] || fail "o diretorio de sessao nao pertence ao usuario atual."
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/brasa
mkdir -p "$state_dir"
chmod 700 "$state_dir"

if ! pgrep -u "$uid" -x pipewire >/dev/null 2>&1; then
  pipewire >>"$state_dir/pipewire.log" 2>&1 &
fi
i=0
while [ "$i" -lt 20 ] && ! pgrep -u "$uid" -x pipewire >/dev/null 2>&1; do
  sleep 0.1
  i=$((i + 1))
done
pgrep -u "$uid" -x pipewire >/dev/null 2>&1 || fail "PipeWire nao iniciou; consulte os logs da sessao."
if ! pgrep -u "$uid" -x wireplumber >/dev/null 2>&1; then
  wireplumber >>"$state_dir/wireplumber.log" 2>&1 &
fi
i=0
while [ "$i" -lt 20 ] && ! pgrep -u "$uid" -x wireplumber >/dev/null 2>&1; do
  sleep 0.1
  i=$((i + 1))
done
pgrep -u "$uid" -x wireplumber >/dev/null 2>&1 || fail "WirePlumber nao iniciou; consulte $state_dir/wireplumber.log."
